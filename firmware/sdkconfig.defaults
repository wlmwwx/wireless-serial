# Wireless Serial — default sdkconfig for ESP32-C3
#
# These values are applied by `idf.py set-target esp32c3` (or `idf.py build`
# when no sdkconfig exists yet).  Application level knobs live in
# firmware/main/Kconfig.projbuild (all prefixed with CONFIG_WSP_).

# Flash: 4 MB is the common ESP32-C3 devkit size; the app partition is 1.5 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# Keep a 1 kHz tick so TCP/UART timeouts are reasonably fine grained.
CONFIG_FREERTOS_HZ=1000

# Main task only does init then spawns the worker tasks.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096

# WebSocket support is required for the /ws terminal.
CONFIG_HTTPD_WS_SUPPORT=y

# Task watchdog: enabled, but a timeout only prints a warning (it must never
# reset a device that is in the middle of a serial session).
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=n

# IPv4 only: saves RAM, mDNS/TCP services are IPv4.
CONFIG_LWIP_IPV6=n
# WSP + RAW listeners, HTTP keep-alive sockets, mDNS and scans need headroom.
CONFIG_LWIP_MAX_SOCKETS=16

# Size matters more than raw speed on a single core C3.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
